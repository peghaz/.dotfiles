# ============================================================
# GHOSTTY — FEDORA KDE DAILY DRIVER
# ~/.config/ghostty/config.ghostty
# ============================================================


# ------------------------------------------------------------
# THEME / APPEARANCE
# ------------------------------------------------------------

# Automatically follow Plasma light/dark mode
theme = light:GitHub,dark:GitHub Dark
window-theme = system

# Frosted-glass effect on KDE / KWin
background-opacity = 0.98
background-blur = true

# Comfortable breathing room
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true

# Make lines slightly less cramped
adjust-cell-height = 4%


# ------------------------------------------------------------
# FONT
# ------------------------------------------------------------

font-family = JetBrains Mono
font-size = 13

# Programming ligatures
font-feature = +calt,+liga

# New tabs/windows inherit any temporary Ctrl +/- font adjustment
window-inherit-font-size = true


# ------------------------------------------------------------
# CURSOR
# ------------------------------------------------------------

cursor-style = block
cursor-style-blink = false
cursor-opacity = 1

# Hide pointer while typing
mouse-hide-while-typing = true

# Allows clicking in compatible shell prompts to move the cursor
cursor-click-to-move = true


# ------------------------------------------------------------
# KDE / GTK WINDOW UI
# ------------------------------------------------------------

# Ghostty draws the titlebar itself.
# This gives the nicest integrated tab experience.
window-decoration = client

# Put tabs inside the title bar, browser-style
gtk-titlebar-style = tabs

# Compact tabs rather than huge GNOME-style tabs
gtk-wide-tabs = false

# Tab bar on top
gtk-tabs-location = top

# Slight divider between chrome and terminal
gtk-toolbar-style = raised-border

# Don't hide the chrome when maximized
gtk-titlebar-hide-when-maximized = false

# Put new tabs next to the current tab rather than always at the end
window-new-tab-position = current


# ------------------------------------------------------------
# WORKING DIRECTORY BEHAVIOR
# ------------------------------------------------------------

# Opening a window from the current terminal keeps cwd
window-inherit-working-directory = true

# New tabs keep cwd
tab-inherit-working-directory = true

# New splits keep cwd
split-inherit-working-directory = true


# ------------------------------------------------------------
# SHELL INTEGRATION
# ------------------------------------------------------------

shell-integration = detect

# Good SSH behavior:
#   ssh-env      -> fall back sensibly when remote lacks Ghostty TERM
#   ssh-terminfo -> automatically install Ghostty terminfo remotely
shell-integration-features = cursor,title,ssh-env,ssh-terminfo


# ------------------------------------------------------------
# SCROLLBACK
# ------------------------------------------------------------

# 64 MiB PER terminal/split
#
# Large enough that build logs don't disappear constantly.
# Ghostty allocates this lazily rather than immediately.
scrollback-limit = 67108864

# Keep UI clean
scrollbar = never

# Typing returns you to current output
scroll-to-bottom = keystroke,no-output

# Slightly faster mouse-wheel scrolling
mouse-scroll-multiplier = 1.5


# ------------------------------------------------------------
# SELECTION / CLIPBOARD
# ------------------------------------------------------------

# Linux-style: selecting text copies it.
#
# "clipboard" means copy to both the primary selection and
# normal system clipboard.
copy-on-select = clipboard

selection-clear-on-typing = true
selection-clear-on-copy = false

# Don't let terminal programs silently READ clipboard contents.
clipboard-read = ask

# Allow terminal applications such as tmux/neovim to write OSC52.
clipboard-write = allow

# Protect against accidentally pasting malicious multiline commands.
clipboard-paste-protection = true

# Keep right-click as a real GUI context menu
right-click-action = context-menu


# ------------------------------------------------------------
# SPLITS
# ------------------------------------------------------------

# Slightly fade inactive panes
unfocused-split-opacity = 0.94

# Keep split zoom while moving between panes
split-preserve-zoom = navigation

# Optional: focus pane simply by hovering it.
# I personally leave this false.
focus-follows-mouse = false


# ------------------------------------------------------------
# COMMAND COMPLETION NOTIFICATIONS
# ------------------------------------------------------------

# Very nice for cargo builds, compilation, downloads, etc.
#
# Only notify when the terminal isn't focused.
notify-on-command-finish = unfocused

# KDE desktop notification, no terminal bell
notify-on-command-finish-action = no-bell,notify

# Don't notify for tiny commands.
notify-on-command-finish-after = 15s


# ------------------------------------------------------------
# CLOSING WINDOWS
# ------------------------------------------------------------

# Ghostty + shell integration knows when something important
# is still running and only asks when appropriate.
confirm-close-surface = true


# ------------------------------------------------------------
# QUICK / DROP-DOWN TERMINAL
# Wayland only
# ------------------------------------------------------------

quick-terminal-position = top
quick-terminal-size = 45%

# Show on top of normal applications
gtk-quick-terminal-layer = top

# Hide again once focus leaves it
quick-terminal-autohide = true

quick-terminal-keyboard-interactivity = on-demand


# ------------------------------------------------------------
# KEYBINDINGS
# ------------------------------------------------------------

# New tab
keybind = ctrl+shift+t=new_tab

# Tab navigation
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab

# New window
keybind = ctrl+shift+n=new_window

# Splits
keybind = ctrl+shift+right=new_split:right
keybind = ctrl+shift+down=new_split:down

# Navigate split panes
keybind = alt+left=goto_split:left
keybind = alt+right=goto_split:right
keybind = alt+up=goto_split:up
keybind = alt+down=goto_split:down

# Maximize/unmaximize current split
keybind = ctrl+shift+enter=toggle_split_zoom

# Command palette
keybind = ctrl+shift+p=toggle_command_palette

# Search terminal history
keybind = ctrl+shift+f=start_search

# Reload config
keybind = ctrl+shift+comma=reload_config

# Quake-style terminal.
# Works globally on Plasma Wayland if the desktop portal supports it.
# keybind = global:ctrl+grave_accent=toggle_quick_terminal
